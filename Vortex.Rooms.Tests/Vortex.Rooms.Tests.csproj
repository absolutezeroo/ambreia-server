<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- The in-memory provider does not implement ExecuteUpdate, and the guarded updates that move
         furniture into and out of a room are exactly what has to be run for real. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Database\Vortex.Database.csproj" />
    <ProjectReference Include="..\Vortex.Events\Vortex.Events.csproj" />
    <ProjectReference Include="..\Vortex.Furniture\Vortex.Furniture.csproj" />
    <ProjectReference Include="..\Vortex.Observability\Vortex.Observability.csproj" />
    <ProjectReference Include="..\Vortex.Players\Vortex.Players.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <ProjectReference Include="..\Vortex.Protocol\Vortex.Protocol.csproj" />
    <ProjectReference Include="..\Vortex.Rooms\Vortex.Rooms.csproj" />
    <ProjectReference Include="..\Vortex.Tests.Support\Vortex.Tests.Support.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      One real furniture bundle, 1.6 KB, straight off the hotel's own asset host. The synthetic
      packs beside it are written to the format as documented; this one is written by whatever
      actually packed the hotel, which is the only thing that can disagree.
    -->
    <None Include="Furniture\Fixtures\*.nitro" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

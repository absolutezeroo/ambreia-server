  "openapi": "3.0.4",
  "info": {
    "title": "Vortex Web API",
    "description": "Client-facing onboarding API for the Vortex emulator: login, registration, avatar management and SSO ticket issuance. Sensitive endpoints are rate limited and the session is carried by the habbo-web-session cookie.",

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet csharpier:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet tool restore:*)",
      "Bash(node scripts/hooks/:*)",
      "Bash(npm run lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/post-edit.mjs"],
            "statusMessage": "Verification dashboard/front-end",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/guard-emulator.mjs"],
            "statusMessage": "Garde emulateur",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/guard-commit.mjs"],
            "statusMessage": "Garde commit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

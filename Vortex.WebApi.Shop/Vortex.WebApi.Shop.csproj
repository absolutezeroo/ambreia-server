<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      The paid shop: what the hotel sells for real money, the orders taken for it, and the one path
      that turns a captured payment into currency or club months.

      Its own assembly rather than a folder in Vortex.WebApi because none of this is about HTTP. The
      website is one caller — the dashboard will be another, and an operator marking a bank transfer
      received is a third — and an order that only exists inside a request pipeline cannot be any of
      them. Vortex.WebApi does not reference this project at all: it resolves IShopService, which
      lives in Vortex.Primitives, so adding a payment provider touches neither the endpoints nor the
      site.

      It depends on the wallet and player grains through their Primitives interfaces, the same way
      every other purchasing module does.
    -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.WebApi.Shop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Database\Vortex.Database.csproj" />
    <ProjectReference Include="..\Vortex.Logging\Vortex.Logging.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
  </ItemGroup>
</Project>

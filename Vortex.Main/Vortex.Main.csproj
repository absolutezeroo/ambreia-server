<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <UserSecretsId>a638c0bb-c7d5-45bc-a28e-daf3be3fcdc6</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- The host's own dependency on ASP.NET Core, because its plugins have one and cannot bring it.
         The dashboard and the web API are byte-loaded, and every Microsoft.AspNetCore.* they ask
         for falls through to the default context, which only holds the shared frameworks named in
         Vortex.Main.runtimeconfig.json. Vortex.WebApi used to put Microsoft.AspNetCore.App there as
         a project reference; making it a plugin took it out, the runtimeconfig went back to
         Microsoft.NETCore.App alone, and both plugins died on
         "Could not load Microsoft.AspNetCore.Http.Abstractions" with "Loaded 0 plugins", on an
         aspnet image that has the files, because a framework is only loaded when the host names it.
         PluginHostFrameworkTests fails if this goes. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Persistence.Memory" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="Microsoft.Orleans.Serialization.Abstractions" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content
      Include="../appsettings.Development.json"
      Condition="Exists('../appsettings.Development.json')"
    >
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </Content>
    <Content
      Include="../appsettings.Production.json"
      Condition="Exists('../appsettings.Production.json')"
    >
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.WebApi.Authentication\Vortex.WebApi.Authentication.csproj" />
    <ProjectReference Include="..\Vortex.Permissions\Vortex.Permissions.csproj" />
    <ProjectReference Include="..\Vortex.World\Vortex.World.csproj" />
    <ProjectReference Include="..\Vortex.Rpg\Vortex.Rpg.csproj" />
    <ProjectReference Include="..\Vortex.Rpg.Characters\Vortex.Rpg.Characters.csproj" />
    <ProjectReference Include="..\Vortex.Rpg.Combat\Vortex.Rpg.Combat.csproj" />
    <ProjectReference Include="..\Vortex.Rpg.Monsters\Vortex.Rpg.Monsters.csproj" />
    <ProjectReference Include="..\Vortex.Rpg.Skills\Vortex.Rpg.Skills.csproj" />
    <ProjectReference Include="..\Vortex.Crypto\Vortex.Crypto.csproj" />
    <ProjectReference Include="..\Vortex.Database\Vortex.Database.csproj" />
    <ProjectReference Include="..\Vortex.Events\Vortex.Events.csproj" />
    <ProjectReference Include="..\Vortex.Furniture\Vortex.Furniture.csproj" />
    <ProjectReference Include="..\Vortex.Logging\Vortex.Logging.csproj" />
    <ProjectReference Include="..\Vortex.Messages\Vortex.Messages.csproj" />
    <ProjectReference Include="..\Vortex.Networking\Vortex.Networking.csproj" />
    <!-- Vortex.Dashboard.API is deliberately NOT referenced, and must not be. It is a loadable
         plugin now, and ByteLoadingAlc hands any assembly the host already holds to the default
         context — so a reference here would quietly make the dashboard impossible to unload, which
         is the entire point of it being a plugin. It is built by the solution and lands in the
         plugin folder from its own csproj. DashboardUnloadabilityTests is what notices if this
         comes back. -->
    <ProjectReference Include="..\Vortex.Observability\Vortex.Observability.csproj" />
    <ProjectReference Include="..\Vortex.PacketHandlers\Vortex.PacketHandlers.csproj" />
    <ProjectReference Include="..\Vortex.Pipeline\Vortex.Pipeline.csproj" />
    <ProjectReference Include="..\Vortex.Players\Vortex.Players.csproj" />
    <ProjectReference Include="..\Vortex.Plugins\Vortex.Plugins.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <ProjectReference Include="..\Vortex.Protocol\Vortex.Protocol.csproj" />
    <ProjectReference Include="..\Vortex.Revisions\Vortex.Revisions.csproj" />
    <ProjectReference Include="..\Vortex.Rooms\Vortex.Rooms.csproj" />
    <!-- Vortex.WebApi is deliberately NOT referenced either, for the dashboard's reason above: it is
         a loadable plugin, and a reference would make it impossible to unload.
         DashboardUnloadabilityTests measures both plugins and notices if this comes back. -->
    <ProjectReference Include="..\Vortex.Runtime\Vortex.Runtime.csproj" />
  </ItemGroup>
</Project>

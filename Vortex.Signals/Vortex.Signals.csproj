<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      The translation layer: one class per domain event, turning it into the canonical signals it
      means, plus the processor that discovers them and the host that publishes them.

      Nothing here knows what a reward track, a daily task or an achievement is, and nothing here
      calls a grain. A translator is a pure function; that is what makes the whole vocabulary
      testable, which the previous shape — a translation welded to an Orleans handler — was not.

      Nobody references this project. Consumers, the content validator and the dashboard depend on
      the interfaces in Vortex.Primitives.Signals and receive the implementations by injection.
      Vortex.Main references it so the assembly scan can see it.
    -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Signals.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Events\Vortex.Events.csproj" />
    <ProjectReference Include="..\Vortex.Logging\Vortex.Logging.csproj" />
    <ProjectReference Include="..\Vortex.Pipeline\Vortex.Pipeline.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <ProjectReference Include="..\Vortex.Runtime\Vortex.Runtime.csproj" />
  </ItemGroup>
</Project>

# Normalize all text
* text=auto

# Force LF for source
*.cs           text eol=lf
*.csproj       text eol=lf
*.props        text eol=lf
*.targets      text eol=lf
*.tt           text eol=lf
*.md           text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.sh           text eol=lf
*.ps1          text eol=lf
.githooks/*    text eol=lf

# Container artefacts are consumed by a Linux shell inside the image; CRLF would leave a stray
# carriage return at the end of every continued RUN line.
Dockerfile     text eol=lf
.dockerignore  text eol=lf

# The chain's sources, and the compiled bytecode the deploy step feeds to `cast send --create`.
# The .hex files are the ones that actually matter: they are `cat`ed inside the container and
# passed straight to a command line, so a trailing carriage return does not read as whitespace —
# it becomes part of the contract's creation code.
*.sol          text eol=lf
*.toml         text eol=lf
*.hex          text eol=lf
*.mjs          text eol=lf

# Keep Windows endings for Windows-specific stuff
*.sln          text eol=crlf
*.bat          text eol=crlf

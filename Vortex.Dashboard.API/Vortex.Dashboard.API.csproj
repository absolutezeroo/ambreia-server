<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      What makes this output a plugin FOLDER rather than just a build output. PluginManager reads
      manifest.json from a directory and byte-loads the assembly it names; with this beside the DLL,
      the bin directory IS a loadable plugin and needs no staging step to be one during development
      (see Vortex:Plugin:DevPluginPaths in appsettings.Development.json).

      The other assemblies here — Vortex.Primitives, Vortex.Database, Vortex.Observability — are
      never byte-loaded with it: ByteLoadingAlc hands any assembly the host already holds to the
      default context, which is what keeps one IVortexPlugin and one VortexDbContext type in the
      process. That is also why Vortex.Main must not reference this project; see its csproj.
    -->
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\*.html" />
    <EmbeddedResource Include="Assets\*.css" />
    <EmbeddedResource Include="Assets\*.js" />
    <EmbeddedResource Include="Assets\*.png" />
    <EmbeddedResource Include="Assets\*.svg" />
    <EmbeddedResource Include="Assets\*.woff2" />
    <!-- Vite emits both, and the CSS asks for both. Without this the .woff half 404s, which is
         invisible in a build log and loud in a browser console. -->
    <EmbeddedResource Include="Assets\*.woff" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Database\Vortex.Database.csproj" />
    <ProjectReference Include="..\Vortex.Observability\Vortex.Observability.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
  </ItemGroup>

  <!--
    Builds the Svelte front-end before its output is embedded, so `dotnet build` alone is enough to
    ship a change to the dashboard.

    Without this the two halves drift apart in the most confusing way available: `npm run build`
    writes to Assets\, but the browser is served the copy compiled into this assembly, so a
    front-end change that was built but not re-embedded looks exactly like a change that never
    worked. Editing, rebuilding and seeing nothing is not a state anybody should have to diagnose.

    Assets\ is generated, not committed (see .gitignore): it is Vite's output directory, every name
    in it is content-hashed, and tracking it meant every dashboard change rewrote ~50 files whose
    diff nobody can read. That makes this target the ONLY source of the embedded front-end. There is
    no committed copy to fall back on, so a missing toolchain has to be repaired or reported, never
    quietly skipped.

    Set SkipDashboardFrontendBuild=true to opt out (a CI job that builds the front-end in its own
    step). A build that opts out embeds whatever Assets\ already holds, which on a clean checkout
    is nothing.
  -->
  <PropertyGroup>
    <DashboardWebDir>$(MSBuildThisFileDirectory)..\Vortex.Dashboard.Web\</DashboardWebDir>
  </PropertyGroup>

  <!--
    A clean checkout has no node_modules, and now no committed Assets\ either, so `dotnet build`
    on a fresh clone would otherwise produce an assembly that serves a blank dashboard. `npm ci`
    rather than `npm install`: package-lock.json is committed, and the build should not be able to
    move a dependency on its own.
  -->
  <Target
    Name="RestoreDashboardFrontend"
    Condition="'$(SkipDashboardFrontendBuild)' != 'true' AND !Exists('$(DashboardWebDir)node_modules')"
  >
    <Message
      Importance="high"
      Text="Dashboard front-end: installing npm dependencies (no node_modules yet)."
    />
    <Exec Command="npm ci" WorkingDirectory="$(DashboardWebDir)" />
  </Target>

  <Target
    Name="BuildDashboardFrontend"
    BeforeTargets="BeforeBuild"
    DependsOnTargets="RestoreDashboardFrontend"
    Condition="'$(SkipDashboardFrontendBuild)' != 'true'"
    Inputs="@(DashboardWebSource)"
    Outputs="$(IntermediateOutputPath)dashboard-frontend.stamp;$(MSBuildThisFileDirectory)Assets\index.html"
  >
    <Exec Command="npm run build" WorkingDirectory="$(DashboardWebDir)" />

    <!--
      Re-gather the embedded files after Vite has written them. The globs at the top of this file
      are expanded when the project is evaluated, which happens before any target runs, so the
      hashed names Vite has just produced are not in that list: without this the build would embed
      the *previous* set and the freshly built page would 404 on its own script.

      The Remove has to repeat the same patterns rather than say `Assets\**`: a bare `**` is not a
      valid MSBuild wildcard (it must be followed by a separator and a pattern), so it silently
      matches nothing. That left both the old and the new hashed names in the list, and the compiler
      failed on the old ones, which Vite had just deleted: CS1566, "could not find file".
    -->
    <ItemGroup>
      <EmbeddedResource Remove="Assets\*.html;Assets\*.css;Assets\*.js;Assets\*.png;Assets\*.svg" />
      <EmbeddedResource Include="Assets\*.html;Assets\*.css;Assets\*.js;Assets\*.png;Assets\*.svg" />
    </ItemGroup>

    <!--
      The stamp lives in obj\, which on a clean checkout does not exist yet: this target runs off
      Inputs/Outputs before the standard PrepareForBuild has created the intermediate directory, so
      Touch failed with MSB3371 and took the whole build with it. Creating the directory first is
      what the ordinary MSBuild targets do for their own outputs.
    -->
    <MakeDir Directories="$(IntermediateOutputPath)" />

    <Touch Files="$(IntermediateOutputPath)dashboard-frontend.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    What the front-end is built from. Declared outside the target so MSBuild can compare timestamps
    and skip the whole thing when nothing has changed, so an untouched dashboard costs no build time.

    Assets\index.html is listed as an output next to the stamp file for a reason: the stamp alone
    claims the build is up to date even when the output it vouches for is gone. Now that Assets\ is
    gitignored, a clean checkout is exactly that state, and the build has to notice the artefact is
    missing rather than trust a stamp left over from a previous one.
  -->
  <ItemGroup>
    <DashboardWebSource
      Include="$(DashboardWebDir)src\**\*"
      Exclude="$(DashboardWebDir)node_modules\**\*"
    />
    <DashboardWebSource Include="$(DashboardWebDir)package.json;$(DashboardWebDir)vite.config.js;$(DashboardWebDir)index.html" />
  </ItemGroup>

  <!--
    Embedding nothing is the one outcome that must not pass quietly: the build succeeds, the tests
    pass, and the dashboard serves a blank page at runtime. Since Assets\ is no longer committed,
    an empty one after the front-end step means the step did not run, and that is an error rather
    than a warning.
  -->
  <Target
    Name="VerifyDashboardFrontendEmbedded"
    AfterTargets="BuildDashboardFrontend"
    Condition="'$(SkipDashboardFrontendBuild)' != 'true'"
  >
    <Error
      Condition="'@(EmbeddedResource)' == ''"
      Text="Dashboard front-end produced no assets: Assets\ is empty and nothing would be embedded, so the dashboard would serve a blank page. Run 'npm ci &amp;&amp; npm run build' in $(DashboardWebDir), or set SkipDashboardFrontendBuild=true if this build embeds the front-end another way."
    />
  </Target>
</Project>

{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Warning",
            "SuperSocket": "Warning",
            "Orleans": "Warning",
            "Vortex": "Information",
            "Vortex.Networking.Package.PackageHandler": "Warning",
            "Vortex.Networking.Package.PackageEncoder": "Warning"
        },
        "Console": {
            "FormatterName": "vortex"
        },
        "VortexConsole": {
            "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff",
            "UseUtcTimestamp": false,
            "SingleLine": true,
            "IncludeCategory": true,
            "TrimCategoryDepth": 1,
            "UseAnsiColor": true,
            "IncludeScopes": true
        }
    },
    "serverOptions": {
        "TcpServer": {
            "name": "TcpServer",
            "listeners": [
                {
                    "ip": "127.0.0.1",
                    "port": 30000
                }
            ]
        },
        "WebSocketServer": {
            "name": "WebSocketServer",
            "listeners": [
                {
                    "ip": "127.0.0.1",
                    "port": 30001
                }
            ]
        }
    },
    "Vortex": {
        "Orleans": {
            "AdvertisedIp": "127.0.0.1",
            "SiloPort": 11111,
            "GatewayPort": 3000
        },
        "Database": {
            "ConnectionString": "CHANGE_ME__set-via-VORTEX__Vortex__Database__ConnectionString-env-var-or-user-secrets",
            "Backup": {
                "Enabled": false,
                "MysqlDumpPath": "",
                "OutputDirectory": "backups",
                "IntervalHours": 24,
                "RetentionCount": 14,
                "TimeoutMinutes": 30
            }
        },
        "Game": {},
        "Shutdown": {
            "NoticeMinutes": 0,
            "DowntimeMinutes": 2,
            "DrainSeconds": 30
        },
        "Authentication": {
            "IpHashSecret": "replace-with-a-production-secret",
            "TicketAbsoluteLifetimeSeconds": 300
        },
        "Networking": {},
        "Observability": {
            "MetricsEnabled": true,
            "TracingEnabled": true,
            "DashboardEnabled": true,
            "DashboardFrontendEnabled": true,
            "DashboardHost": "localhost",
            "DashboardPort": 9000,
            "AuditWriteRetryAttempts": 2,
            "AuditWriteRetryDelayMs": 250,
            "AuditDeadLetterPath": "logs/audit-dead-letter.jsonl",
            "AssetBaseUrl": "",
            "FurniIconUrlTemplate": "/dcr/hof_furni/icons/{name}_icon.png",
            "CatalogIconUrlTemplate": "/c_images/catalogue/icon_{id}.png",
            "TargetedOfferImageUrlTemplate": "/c_images/targetedoffers/{file}",
            "AvatarImageUrlTemplate": "/habbo-imaging/avatarimage?figure={figure}&headonly=1&size=m&direction=2&head_direction=2",
            "GroupBadgeUrlTemplate": "/habbo-imaging/badge-fill/{badge}.png",
            "BadgeImageUrlTemplate": "/c_images/album1584/{badge}.gif",
            "HandItemImageUrlTemplate": "/habbo-imaging/avatarimage?figure={figure}&action=crr={item}&size=m&direction=2&head_direction=2&gesture=sml",
            "AvatarEffectImageUrlTemplate": "/habbo-imaging/avatarimage?figure={figure}&effect={effect}&size=m&direction=2&head_direction=2&gesture=sml",
            "FigureImageUrlTemplate": "/habbo-imaging/clothing/{figure}.png",
            "PetImageUrlTemplate": "/habbo-imaging/pet/{type}.png",
            "QuestImageUrlTemplate": "/c_images/Quests/{version}.png",
            "AssetsLocalRoot": "./assets"
        },
        "WebApi": {
            "Enabled": true,
            "Host": "localhost",
            "Port": 8080,
            "MetricsEnabled": false,
            "MetricsPath": "/metrics",
            "MetricsToken": "",
            "MaxAvatarsPerAccount": 5,
            "DefaultFigure": "hr-115-42.hd-195-19.ch-3030-82.lg-275-1408.fa-1201.ca-1804-64"
        },
        "Shop": {
            "Enabled": false,
            "Provider": "manual",
            "ProviderSecrets": {
                "manual": "CHANGE_ME__set-via-VORTEX__Vortex__Shop__ProviderSecrets__manual__at-least-32-chars"
            },
            "WebhookToleranceSeconds": 300,
            "MaximumOpenOrders": 10
        },
        "Crypto": {
            "KeySize": "3",
            "PublicKey": "CHANGE_ME__generate-a-fresh-1024-bit-RSA-keypair-set-via-VORTEX__Vortex__Crypto__PublicKey",
            "PrivateKey": "CHANGE_ME__set-via-VORTEX__Vortex__Crypto__PrivateKey-env-var-or-user-secrets",
            "EnableServerToClientEncryption": true
        }
    }
}
